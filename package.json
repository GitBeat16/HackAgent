{
  "name": "boardroomai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered virtual board of directors — frontend only.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:orchestration": "tsx --tsconfig tsconfig.json scripts/test-orchestration.ts",
    "test:session": "tsx --tsconfig tsconfig.json scripts/test-session.ts",
    "test:factcheck": "tsx --tsconfig tsconfig.json scripts/test-fact-check.ts",
    "test:tts": "tsx --tsconfig tsconfig.json scripts/test-edge-tts.ts",
    "test:metrics": "tsx --tsconfig tsconfig.json scripts/test-eval-metrics.ts",
    "piper:voices": "tsx --tsconfig tsconfig.json scripts/fetch-piper-voices.ts",
    "piper:samples": "tsx --tsconfig tsconfig.json scripts/piper-samples.ts",
    "test:piper": "tsx --tsconfig tsconfig.json scripts/test-piper.ts",
    "test:normalise": "tsx --tsconfig tsconfig.json scripts/test-normalisation.ts",
    "test:schema": "tsx --tsconfig tsconfig.json scripts/test-schema-drift.ts",
    "test": "npm run test:orchestration && npm run test:session && npm run test:factcheck && npm run test:tts && npm run test:metrics && npm run test:normalise && npm run test:schema && npm run test:piper",
    "eval": "tsx --tsconfig tsconfig.json scripts/eval-board.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.454.0",
    "next": "^16.2.0",
    "next-themes": "^0.4.3",
    "postcss": "^8.4.47",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "recharts": "^3.0.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vaul": "^1.1.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.0",
    "tsx": "^4.19.2"
  }
