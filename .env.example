# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Powers every AI executive persona and every generated deliverable
# (lib/ai/groq.ts). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — pin a different model. Leave commented to use
# llama-3.3-70b-versatile. Models that support strict JSON-schema output
# (e.g. openai/gpt-oss-120b, moonshotai/kimi-k2-instruct-0905) give the most
# reliable reports; others fall back to plain JSON mode automatically.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — model for spoken debate turns only. These are the bulk of a
# session's calls and the easiest work in the app, so they default to a small
# model (llama-3.1-8b-instant). Groq meters rate limits per model, so this
# also keeps debate traffic off the bucket the final report depends on.
# Set it equal to GROQ_MODEL to run everything on one model as before.
# GROQ_DEBATE_MODEL=llama-3.1-8b-instant

# Supabase project settings (Project Settings → API). The anon/publishable
# key is safe in the browser; never expose the service-role key in Next.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — milliseconds between debate turns. The default (15000) paces a
# session to stay inside Groq's free-tier budget of 6,000 tokens per minute:
# ~1,500 tokens a turn allows four turns a minute. A 16-turn session takes
# about four minutes as a result. On a paid tier lower this, or set it to 0
# to fire turns back-to-back. Rate-limited turns are retried automatically
# either way, so this changes pacing, not reliability.
# NEXT_PUBLIC_TURN_INTERVAL_MS=15000

# Optional — web search for the Research and VC agents, so they cite real
# sources instead of estimating. Free tier is 1,000 searches a month, no card:
# https://tavily.com  Without it the board still runs, but those two seats are
# instructed to label every figure as their own estimate.
TAVILY_API_KEY=

# Optional — how long a session runs.
#   full  (default) 3 phases x 1 turn each = 24 turns for a full 8-seat board
#   demo            drops closing statements = 16 turns, keeps cross-examination
#   deep            2/2/1 = 40 turns
# Use `demo` when you need a session to fit inside a live demo slot.
# NEXT_PUBLIC_DEBATE_PROFILE=full

# Optional — only needed if you wire up deck/file uploads in
# app/api/pitches/route.ts via an object store (e.g. Vercel Blob).
BLOB_READ_WRITE_TOKEN=
